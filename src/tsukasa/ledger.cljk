(ns tsukasa.ledger
  "司 — the itonami node ledger. Pure: takes values, returns values.
  Registration records, declaration validation, lifecycle transitions and a
  failure-domain audit. Placement (murakumo, sahai), execution (kototama) and
  grants (aiueos) are other layers and do not appear here.")

;; ---------------------------------------------------------------------------
;; Closed vocabularies. No defaults anywhere: a default would be a claim about
;; a node's reliability that nobody made (same rule as kura-node's
;; :independence-profiles).

(def availability-values
  "The closed set :node/availability must be a member of."
  #{:always-on :intermittent})

(def lifecycle-states
  #{:proposed :admitted :active :draining :retired})

(def lifecycle-transitions
  "Legal transitions only. :retired is terminal — nothing follows it."
  {:proposed  #{:admitted :retired}
   :admitted  #{:active :retired}
   :active    #{:draining}
   :draining  #{:active :retired}
   :retired   #{}})

;; Pinned refusal reasons. Callers and tests match on these literals; changing
;; one is a breaking change.

(def reasons
  {:missing-id             :tsukasa/missing-id
   :missing-did            :tsukasa/missing-did
   :bad-did                :tsukasa/bad-did
   :missing-failure-domain :tsukasa/missing-failure-domain
   :missing-availability   :tsukasa/missing-availability
   :bad-availability       :tsukasa/bad-availability
   :unknown-node           :tsukasa/unknown-node
   :duplicate-id           :tsukasa/duplicate-id
   :illegal-transition     :tsukasa/illegal-transition
   :unknown-state          :tsukasa/unknown-state})

;; ---------------------------------------------------------------------------
;; Registration

(defn- blank? [s]
  (or (nil? s) (and (string? s) (empty? s))))

(defn- has-prefix?
  "Pure prefix test. No host interop — this file must load identically under
  kbb (sci) and a JVM."
  [s p]
  (and (string? s)
       (<= (count p) (count s))
       (= p (subs s 0 (count p)))))

(defn registration-problems
  "Validate a node declaration. Returns a vector of pinned reason keywords,
  empty when the declaration is acceptable. Order is stable (field order) so
  tests can pin the first problem."
  [node]
  (cond-> []
    (blank? (:node/id node))
    (conj (:missing-id reasons))

    (blank? (:node/did node))
    (conj (:missing-did reasons))

    (and (not (blank? (:node/did node)))
         (not (has-prefix? (:node/did node) "did:key:")))
    (conj (:bad-did reasons))

    (let [fd (:node/failure-domain node)]
      (or (not (map? fd)) (empty? fd)))
    (conj (:missing-failure-domain reasons))

    (nil? (:node/availability node))
    (conj (:missing-availability reasons))

    (and (some? (:node/availability node))
         (not (contains? availability-values (:node/availability node))))
    (conj (:bad-availability reasons))))

(def empty-ledger
  {:tsukasa/nodes {}})

(defn register
  "Add a node declaration to the ledger. Returns
  {:ok ledger'} or {:reason k :problems [..]}. On refusal no ledger is
  returned — a refused registration cannot leak in through a stale handle.
  A node id already present is :duplicate-id; records are amended by explicit
  transition, never by re-registration."
  [ledger node]
  (let [problems (registration-problems node)]
    (cond
      (seq problems)
      {:reason (first problems) :problems problems}

      (contains? (:tsukasa/nodes ledger) (:node/id node))
      {:reason (:duplicate-id reasons) :problems [(:duplicate-id reasons)]}

      :else
      {:ok (assoc-in ledger
                     [:tsukasa/nodes (:node/id node)]
                     (assoc node :node/lifecycle :proposed))})))

(defn lookup
  "The node record, or nil. Shaped so a caller can branch on nil without
  inventing a sentinel."
  [ledger node-id]
  (get-in ledger [:tsukasa/nodes node-id]))

;; ---------------------------------------------------------------------------
;; Lifecycle

(defn transition
  "Move a node to `to`. Returns {:ok ledger'} or {:reason k}. Illegal
  transitions (including anything out of :retired) are refused with
  :illegal-transition; an unknown state name is refused with :unknown-state
  so a typo is never read as an illegal transition."
  [ledger node-id to]
  (let [node (lookup ledger node-id)
        from (:node/lifecycle node)]
    (cond
      (nil? node)
      {:reason (:unknown-node reasons)}

      (not (contains? lifecycle-states to))
      {:reason (:unknown-state reasons)}

      (not (contains? (get lifecycle-transitions from #{}) to))
      {:reason (:illegal-transition reasons) :from from :to to}

      :else
      {:ok (assoc-in ledger [:tsukasa/nodes node-id :node/lifecycle] to)})))

;; ---------------------------------------------------------------------------
;; Audit

(defn audit
  "Collapse the ledger into failure domains and say what that means. Counts
  NODES, not declared capabilities — a fleet whose nodes share one failure
  domain has that domain's reliability, whatever the node count."
  [ledger]
  (let [nodes   (vals (:tsukasa/nodes ledger))
        domains (frequencies (map :node/failure-domain nodes))
        n       (count nodes)
        d       (count domains)
        largest (if (seq domains) (apply max (vals domains)) 0)]
    {:nodes n
     :effective-domains d
     :largest-domain largest
     ;; The fact, not the policy: the caller holds the tolerance. A fleet
     ;; cannot survive the loss of more domains than it has spare.
     :single-domain? (and (pos? n) (= 1 d))}))
