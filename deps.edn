{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {;; kbb -M:test — minimal runner, no cognitect. The explicit namespace list in
  ;; test_runner is what makes a missing namespace a visible failure.
  :test {:extra-paths ["test"]
         :main-opts ["-m" "tsukasa.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
