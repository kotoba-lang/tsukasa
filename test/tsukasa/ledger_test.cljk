(ns tsukasa.ledger-test
  (:require [clojure.test :refer [deftest is testing]]
            [tsukasa.ledger :as l]))

(def ok-node
  {:node/id "naphtali"
   :node/did "did:key:z6Mkexample"
   :node/failure-domain {:provider "b2" :site "home"}
   :node/availability :intermittent})

;; ---------------------------------------------------------------------------
;; Registration — refusal is the point. Every negative test pins the REASON
;; literal, not just "it failed": a refusal for the wrong reason is a
;; different bug wearing the same clothes.

(deftest a-complete-declaration-registers
  (let [{:keys [ok]} (l/register l/empty-ledger ok-node)]
    (is (some? ok))
    (is (= :proposed (:node/lifecycle (l/lookup ok "naphtali"))))
    (testing "the record is stored as declared, not normalized"
      (is (= "did:key:z6Mkexample" (:node/did (l/lookup ok "naphtali")))))))

(deftest failure-domain-has-no-default
  (let [{:keys [reason problems]} (l/register l/empty-ledger (dissoc ok-node :node/failure-domain))]
    (is (= :tsukasa/missing-failure-domain reason)
        "the reason literal is the contract, not merely falsy truth")
    (is (= [:tsukasa/missing-failure-domain] problems)))
  (testing "an empty map is also a declaration of nothing"
    (is (= :tsukasa/missing-failure-domain
           (:reason (l/register l/empty-ledger (assoc ok-node :node/failure-domain {})))))))

(deftest availability-has-no-default
  (let [{:keys [reason]} (l/register l/empty-ledger (dissoc ok-node :node/availability))]
    (is (= :tsukasa/missing-availability reason)))
  (testing "the set is closed — an unknown value is refused, not coerced"
    (let [{:keys [reason]} (l/register l/empty-ledger (assoc ok-node :node/availability :mostly-on))]
      (is (= :tsukasa/bad-availability reason)))))

(deftest identity-is-shaped
  (testing "a blank id is not an id"
    (is (= :tsukasa/missing-id
           (:reason (l/register l/empty-ledger (assoc ok-node :node/id ""))))))
  (testing "a missing did is refused"
    (is (= :tsukasa/missing-did
           (:reason (l/register l/empty-ledger (dissoc ok-node :node/did))))))
  (testing "shape only: did:key prefix. Signature verification is not this layer"
    (is (= :tsukasa/bad-did
           (:reason (l/register l/empty-ledger (assoc ok-node :node/did "did:web:example.com")))))))

(deftest refused-registration-leaks-nothing
  (let [{:keys [ok reason]} (l/register l/empty-ledger (dissoc ok-node :node/failure-domain))]
    (is (nil? ok) "no ledger handle comes back on refusal")
    (is (= :tsukasa/missing-failure-domain reason))
    (is (nil? (l/lookup l/empty-ledger "naphtali")))))

(deftest re-registration-is-refused
  (let [{:keys [ok]} (l/register l/empty-ledger ok-node)]
    (is (= :tsukasa/duplicate-id
           (:reason (l/register ok ok-node)))
        "records are amended by transition, never by re-registration")))

;; ---------------------------------------------------------------------------
;; Lifecycle

(deftest the-happy-path-walks-the-whole-chain
  (let [{ledger :ok} (l/register l/empty-ledger ok-node)
        {:keys [ok]} (-> ledger
                         (l/transition "naphtali" :admitted)
                         (as-> m (l/transition (:ok m) "naphtali" :active))
                         (as-> m (l/transition (:ok m) "naphtali" :draining))
                         (as-> m (l/transition (:ok m) "naphtali" :active))
                         (as-> m (l/transition (:ok m) "naphtali" :draining))
                         (as-> m (l/transition (:ok m) "naphtali" :retired)))]
    (is (= :retired (:node/lifecycle (l/lookup ok "naphtali"))))))

(deftest illegal-transitions-are-refused-with-the-pinned-reason
  (let [{ledger :ok} (l/register l/empty-ledger ok-node)
        {:keys [reason from to]} (l/transition ledger "naphtali" :active)]
    (is (= :tsukasa/illegal-transition reason)
        ":proposed → :active skips :admitted; reason literal is pinned")
    (is (= :proposed from))
    (is (= :active to)))
  (testing "the ledger is unchanged after a refusal"
    (let [{ledger :ok} (l/register l/empty-ledger ok-node)
          _ (l/transition ledger "naphtali" :active)]
      (is (= :proposed (:node/lifecycle (l/lookup ledger "naphtali")))
          "transition returns a new ledger; the refusal returned nothing"))))

(deftest retired-is-terminal
  (let [{ledger :ok} (l/register l/empty-ledger ok-node)
        {retired :ok} (l/transition ledger "naphtali" :retired)]
    (is (= :retired (:node/lifecycle (l/lookup retired "naphtali"))))
    (testing "nothing follows :retired, not even :retired again"
      (doseq [to [:proposed :admitted :active :draining :retired]]
        (is (= :tsukasa/illegal-transition
               (:reason (l/transition retired "naphtali" to)))
            (str "out of :retired to " to))))))

(deftest a-typo-is-not-an-illegal-transition
  (let [{ledger :ok} (l/register l/empty-ledger ok-node)]
    (is (= :tsukasa/unknown-state
           (:reason (l/transition ledger "naphtali" :actvie)))
        "a misspelled state is refused as a typo, not counted as a policy hit"))
  (testing "an unknown node is its own refusal"
    (is (= :tsukasa/unknown-node
           (:reason (l/transition l/empty-ledger "ghost" :admitted))))))

;; ---------------------------------------------------------------------------
;; Audit — nodes collapse into failure domains; the count of nodes is not the
;; count of independent things.

(deftest audit-counts-domains-not-nodes
  (let [mk (fn [id fd] {:node/id id
                        :node/did (str "did:key:" id)
                        :node/failure-domain fd
                        :node/availability :always-on})
        {ledger :ok} (-> l/empty-ledger
                         (l/register (mk "a" {:provider "b2" :site "home"}))
                         (as-> m (l/register (:ok m) (mk "b" {:provider "b2" :site "home"})))
                         (as-> m (l/register (:ok m) (mk "c" {:provider "gcp" :site "tokyo"}))))
        a (l/audit ledger)]
    (is (= 3 (:nodes a)))
    (is (= 2 (:effective-domains a))
        "three nodes, two domains")
    (is (= 2 (:largest-domain a)))
    (is (false? (:single-domain? a))))
  (testing "the shape of the trap this audit exists to name"
    (let [mk (fn [id] {:node/id id :node/did (str "did:key:" id)
                       :node/failure-domain {:provider "b2" :site "home"}
                       :node/availability :always-on})
          {ledger :ok} (-> l/empty-ledger
                           (l/register (mk "a"))
                           (as-> m (l/register (:ok m) (mk "b")))
                           (as-> m (l/register (:ok m) (mk "c"))))
          a (l/audit ledger)]
      (is (= 3 (:nodes a)))
      (is (= 1 (:effective-domains a)))
      (is (true? (:single-domain? a))
          "26 pseudo-nodes on one account are one node — kura-node's lesson"))))

(deftest audit-of-an-empty-ledger-is-zero-not-a-lie
  (let [a (l/audit l/empty-ledger)]
    (is (= 0 (:nodes a)))
    (is (= 0 (:effective-domains a)))
    (is (false? (:single-domain? a))
        "an empty fleet is not a single-domain fleet")))
